{
  "branches": [
    "main"
  ],
  "tagFormat": "${version}",
  "plugins": [
    "@semantic-release/commit-analyzer",
    [
      "@google/semantic-release-replace-plugin",
      {
        "replacements": [
          {
            "files": [
              "src/doukimd/__init__.py"
            ],
            "from": "return '.*'  # semantic-release",
            "to": "return '${nextRelease.version}'  # semantic-release",
            "results": [
              {
                "file": "src/doukimd/__init__.py",
                "hasChanged": true,
                "numMatches": 1,
                "numReplacements": 1
              }
            ],
            "countMatches": true
          },
          {
            "files": [
              "pyproject.toml"
            ],
            "from": "version = \".*\"  # semantic-release",
            "to": "version = \"${nextRelease.version}\"  # semantic-release",
            "results": [
              {
                "file": "pyproject.toml",
                "hasChanged": true,
                "numMatches": 1,
                "numReplacements": 1
              }
            ],
            "countMatches": true
          },
          {
            "files": [
              "doukimd.yaml"
            ],
            "from": "version: \".*\"",
            "to": "version: \"${nextRelease.version}\"",
            "results": [
              {
                "file": "doukimd.yaml",
                "hasChanged": true,
                "numMatches": 1,
                "numReplacements": 1
              }
            ],
            "countMatches": true
          }
        ]
      }
    ],
    "@semantic-release/release-notes-generator",
    [
      "@semantic-release/changelog",
      {
        "changelogTitle": "# Release Notes\n---",
        "changelogFile": "docs/changelog.md"
      }
    ],
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "poetry lock && poetry build",
        "publishCmd": "poetry publish"
      }
    ],
    [
      "@semantic-release/github",
      {
        "assets": [
          "dist/*.whl",
          "dist/*.tar.gz"
        ]
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": [
          "pyproject.toml",
          "docs/changelog.md",
          "src/doukimd/__init__.py",
          "doukimd.yaml",
          "poetry.lock"
        ],
        "message": "chore(release): ${nextRelease.version}"
      }
    ]
  ]
}
